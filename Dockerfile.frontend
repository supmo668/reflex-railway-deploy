# Build stage
FROM python:3.11-slim AS builder

# Install all dependencies and set build-time memory limits
RUN apt-get update && apt-get install -y \
    build-essential \
    libstdc++6 \
    gcc \
    g++ \
    libpq-dev \
    postgresql-client \
    unzip \
    parallel \
    curl \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install dependencies
COPY pyproject.toml uv.lock* ./
RUN pip install uv && uv sync --frozen

# Copy .env file explicitly (ignored by git)
COPY .env* ./

# Copy application
COPY . .

# Debug: Verify assets directory and styles.css exist after copy
RUN ls -la /app/ && ls -la /app/assets/ && ls -la /app/assets/styles.css

# Add build-time environment variables for Clerk (required for Next.js SSR)
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG CLERK_PUBLISHABLE_KEY
ARG CLERK_SECRET_KEY
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV CLERK_PUBLISHABLE_KEY=$CLERK_PUBLISHABLE_KEY
ENV CLERK_SECRET_KEY=$CLERK_SECRET_KEY

# Build with all optimizations disabled
ENV NODE_OPTIONS="--max-old-space-size=12288 --max-semi-space-size=2048"
ENV NEXT_DISABLE_SWC_WASM=1
ENV NEXT_SWC_MINIFY=false
ENV DISABLE_WASM=1
ENV V8_FLAGS="--max-wasm-memory=4096"

# Build the application
RUN uv run reflex init && \
    uv run reflex export --no-zip

# Runtime stage
FROM python:3.11-slim

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    libstdc++6 \
    libpq-dev \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js for runtime
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built application from builder
COPY --from=builder /app /app

# Install uv for runtime
RUN pip install uv

# Runtime environment with lower memory limits
ENV NODE_OPTIONS="--max-old-space-size=4096"
ENV NEXT_DISABLE_SWC_WASM=1

# Create simplified startup script (relies on .env file for configuration)
RUN echo '#!/bin/bash\n\
set -e\n\
ulimit -n 16384\n\
ulimit -u 1024\n\
# Export Node.js settings\n\
export NODE_OPTIONS="--max-old-space-size=4096"\n\
export NEXT_DISABLE_SWC_WASM=1\n\
# Export essential Reflex settings\n\
export REFLEX_SHOW_BUILT_WITH_REFLEX=0\n\
export REFLEX_ENV_MODE="${REFLEX_ENV_MODE:-prod}"\n\
# Run reflex (config.py will load .env file automatically)\n\
exec uv run reflex run --frontend-only --env ${REFLEX_ENV_MODE:-prod}' > /app/start.sh && \
    chmod +x /app/start.sh

EXPOSE 3000
CMD ["/app/start.sh"]