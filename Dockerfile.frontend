# Use Python 3.13 slim image as base
FROM python:3.13-slim

# Install system dependencies required for Reflex and PostgreSQL
RUN apt-get update && apt-get install -y \
    build-essential \
    libstdc++6 \
    gcc \
    g++ \
    libpq-dev \
    postgresql-client \
    unzip \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install uv

# Set working directory
WORKDIR /app

# Copy pyproject.toml and uv.lock for better caching
COPY pyproject.toml uv.lock* ./

# Copy local editable dependencies required by uv sync
# These are referenced as editable packages in pyproject.toml/uv.lock
COPY reflex-audio-capture/ ./reflex-audio-capture/
COPY reflex-clerk-api/ ./reflex-clerk-api/

# Set pretend versions for setuptools_scm packages (no .git in Docker)
# These packages use dynamic versioning that requires git metadata
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_REFLEX_AUDIO_CAPTURE=0.0.5
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_REFLEX_CLERK_API=0.0.1

# Install Python dependencies using uv
RUN uv sync --frozen

# Copy the rest of the application
COPY . .

# Set default PORT for frontend
ENV PORT=3000

# Expose the port that Reflex frontend runs on
EXPOSE 3000

# Command to run the frontend
CMD ["uv", "run", "reflex", "run", "--env", "prod", "--frontend-only"]
